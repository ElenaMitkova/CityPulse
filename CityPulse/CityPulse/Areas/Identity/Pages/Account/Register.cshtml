@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="glass-panel-light p-5 shadow-lg w-100" style="max-width: 550px;">

        <div class="text-center mb-4">
            <h1 class="h2 fw-bold text-gradient">Create profile</h1>
            <p class="text-muted small">Be involved</p>
        </div>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control glass-input" autocomplete="username" aria-required="true" placeholder="Antony Inavov" />
                <label asp-for="Input.Name" class="form-label text-secondary">Full Name</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control glass-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="text-secondary">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control glass-input" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password" class="text-secondary">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control glass-input" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.ConfirmPassword" class="text-secondary">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill mb-4 shadow">Register</button>
            <div class="text-center">
                <p class="small text-secondary mb-0">Already have an account? 
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-primary text-decoration-none">Log in</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}