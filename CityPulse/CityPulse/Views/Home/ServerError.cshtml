@{
    ViewData["Title"] = "Server Error";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="glass-panel p-5 text-center shadow-lg rounded-4 border-0 border-top border-danger border-5">
        <div class="mb-3 text-danger">
            <i class="bi bi-exclamation-triangle-fill display-3"></i>
        </div>
        <h1 class="h2 fw-bold">Something went wrong!</h1>
        <p class="text-muted">Our team has been notified and we are working to fix the issue. Please try again later.</p>
        <a href="javascript:location.reload()" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-clockwise me-2"></i>Retry
        </a>
    </div>
</div>