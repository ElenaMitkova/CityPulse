<div class="container py-5 text-center">
    <h1 class="fw-bold mb-2">How CityPulse Works</h1>
    <p class="text-muted mb-5">Your voice is the key to a better city environment.</p>

    <div class="row g-4 justify-content-center">

        <div class="col-md-4">
            <div class="glass-panel-light p-4 h-100 rounded-4 shadow-sm border-0">
                <div class="display-5 text-primary mb-3">01</div>
                <h4 class="fw-bold">Locate it</h4>
                <p class="small text-secondary">Select your city and district so we know exactly where the help is needed.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="glass-panel-light p-4 h-100 rounded-4 shadow-sm border-0">
                <div class="display-5 text-primary mb-3">02</div>
                <h4 class="fw-bold">Change it</h4>
                <p class="small text-secondary">Track the status as local authorities take action based on your report.</p>
            </div>
        </div>
    </div>

    <div class="mt-5 pt-4">
        <h5 class="fw-bold">Ready to make a difference?</h5>
        <a asp-controller="Reports" asp-action="Create" asp-auto-action="Create" class="btn btn-primary-gradient px-5 py-3 rounded-pill fw-bold mt-3">
            Submit Your First Report
        </a>
    </div>
</div>