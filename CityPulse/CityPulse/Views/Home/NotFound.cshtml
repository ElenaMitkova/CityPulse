@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="glass-panel p-5 text-center shadow-lg rounded-4 border-0">
        <h1 class="display-1 fw-bold text-primary">404</h1>
        <h2 class="mb-4">Oops! This street is a dead end.</h2>
        <p class="text-muted mb-4">The page you are looking for doesn't exist or has been moved.</p>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2">
            <i class="bi bi-house-door me-2"></i>Back to Safety
        </a>
    </div>
</div>