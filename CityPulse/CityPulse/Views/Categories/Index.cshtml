@model IEnumerable<Category>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">Report Categories</h2>
            <p class="text-muted small">Manage the types of issues citizens can report</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-2"></i> Add New Category
        </a>
    </div>

    <div class="glass-panel-light rounded-4 shadow-sm overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3 border-0 text-uppercase small fw-bold text-muted">Category Name</th>
                    <th class="py-3 border-0 text-uppercase small fw-bold text-muted text-center">Active Reports</th>
                    <th class="pe-4 py-3 border-0 text-end text-uppercase small fw-bold text-muted">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="category-icon-box me-3">
                                    <i class="bi bi-tag-fill text-primary"></i>
                                </div>
                                <span class="fw-bold text-dark">@item.Name</span>
                            </div>
                        </td>
                        <td class="py-3 text-center">
                            <span class="badge rounded-pill bg-light text-dark border px-3">
                                @item.Reports?.Count()
                            </span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="btn-group shadow-sm rounded-pill">
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Delete">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .category-icon-box {
        width: 35px;
        height: 35px;
        background: rgba(13, 110, 253, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }
    .btn-white {
        background: #fff;
        border: none;
    }
    .btn-white:hover {
        background: #f8f9fa;
    }
</style>