@model ReportModel
@{
    ViewData["Title"] = "Report";

    IEnumerable<Category> selected = ViewData["Categories"] as List<Category> ?? new List<Category>();
    IEnumerable<SelectListItem> categories = selected.Select(x => new SelectListItem()
    {
        Text = x.Name,
        Value = x.Id.ToString()
    });

    IEnumerable<GroupedDistricts> districts = ViewData["Districts"] as List<GroupedDistricts> ?? new List<GroupedDistricts>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="p-5 shadow-lg border-0" style="border-radius: 30px;">
                <div class="text-center mb-5">
                    <h1 class="display-6 fw-bold text-gradient">Report</h1>
                    <p class="text-secondary">Describe the problem to help the community.</p>
                </div>
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold text-dark">Title</label>
                        <input asp-for="Title" class="form-control glass-input py-3"/>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold text-dark">Category</label>
                            <select asp-for="CategoryId" class="form-select glass-input py-3" asp-items="categories">
                                <option value="">-- Choose --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DistrictId" class="form-label fw-bold text-dark">District</label>
                            <select asp-for="DistrictId" class="form-select glass-input py-3">
                                <option value="">-- Choose a district --</option>
                                @foreach (var group in districts)
                                {
                                    <optgroup label="@group.City">
                                        @foreach (var district in group.Districts)
                                        {
                                            <option value="@district.Id">@district.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-dark">Description</label>
                        <textarea asp-for="Description" class="form-control glass-input" rows="4" placeholder="Describe the problem...."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-3 mt-5">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 flex-grow-1">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 flex-grow-1 shadow">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>