@using System.Security.Claims
@model ReportModel

@{
    ViewData["Title"] = "Report Details";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Back to All Reports
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="glass-panel-light p-4 p-md-5 rounded-4 shadow-sm h-100">
                
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-2">
                            <i class="bi bi-tag-fill me-1"></i> @Model.Category?.Name
                        </span>
                        <h1 class="fw-bold display-5">@Model.Title</h1>
                    </div>
                    <span class="badge @(Model.Status.ToString() == "Resolved" ? "bg-success" : "bg-warning") px-3 py-2">
                        @Model.Status
                    </span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <p class="text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger"></i> Location</p>
                        <h5 class="fw-bold">@Model.District?.City?.Name, @Model.District?.Name</h5>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted mb-1"><i class="bi bi-calendar-check"></i> Reported on</p>
                        <h5 class="fw-bold">@Model.CreatedOn.ToString("f")</h5>
                    </div>
                </div>

                <hr class="my-4 opacity-25">

                <h4 class="fw-bold mb-3">Description</h4>
                <p class="text-secondary lh-lg">
                    @Model.Description
                </p>
            </div>
        </div>
        <div class="col-lg-4 mt-4 mt-lg-0">
            @if (User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId)
            {
                <div class="glass-panel-light p-4 rounded-4 shadow-sm border-0">
                    <div class="mt-4 d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark rounded-pill">
                            <i class="bi bi-pencil-square me-2"></i> Edit Report
                        </a>
                    </div>
                    @if (User.IsInRole("Administrator"))
                    {
                        <div class="mt-4 d-grid gap-2">
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-dark rounded-pill">
                                <i class="bi bi-pencil-square me-2"></i> Delete Report
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>