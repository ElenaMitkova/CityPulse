@model ReportModel
@{
    ViewData["Title"] = "Edit Report";
    IEnumerable<GroupedDistricts> districts = ViewData["Districts"] as List<GroupedDistricts> ?? new List<GroupedDistricts>();
}

<div class="container py-5">
    <div class="glass-panel-light p-4 rounded-4 shadow-sm max-width-700 mx-auto">
        <h2 class="fw-bold mb-4">Edit Report</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedOn" />
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Title</label>
                <input asp-for="Title" class="form-control glass-input" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-muted">Category</label>
                <div class="glass-input p-3 rounded-3 bg-light d-flex align-items-center">
                    <i class="bi bi-tag-fill me-2 text-primary"></i>
                    <span class="fw-bold">@Model.Category?.Name</span>
                </div>
                <input type="hidden" asp-for="CategoryId" />
            </div>
            <div class="mb-3">
                <label asp-for="DistrictId" class="form-label fw-bold">Location</label>
                <select asp-for="DistrictId" class="form-select glass-input py-3">
                    <option value="">-- Choose a district --</option>
                    @foreach (var group in districts)
                    {
                        <optgroup label="@group.City">
                            @foreach (var district in group.Districts)
                            {
                                <option value="@district.Id">@district.Name</option>
                            }
                        </optgroup>
                    }
                </select>
                <span asp-validation-for="DistrictId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-bold">Update Status</label>
                <select asp-for="Status" class="form-select glass-input" asp-items="Html.GetEnumSelectList<CityPulse.Models.Enums.ReportStatus>()"></select>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control glass-input" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-gradient rounded-pill px-4">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>