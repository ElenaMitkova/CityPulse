@model IEnumerable<ReportModel>
@{
    IEnumerable<Category> selected = ViewData["Categories"] as List<Category> ?? new List<Category>();
    IEnumerable<SelectListItem> categories = selected.Select(x => new SelectListItem()
    {
        Text = x.Name,
        Value = x.Id.ToString()
    });
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">Reports</h2>

    <div class="glass-panel-light p-3 mb-5 rounded-4 shadow-sm">
        <form asp-action="Index" method="get" class="row align-items-center">
            <div class="col-md-4">
                <label class="small fw-bold text-muted mb-1">Filter by Category</label>
                <select name="categoryId" class="form-select border-0 shadow-none" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == ViewData["SelectedCategoryId"]?.ToString() ? "selected" : null)">
                            @category.Text
                        </option>
                    }
                </select>
            </div>
            
            @if (ViewBag.SelectedCategoryId != null)
            {
                <div class="col-md-2 mt-4">
                    <a asp-action="Index" class="text-decoration-none small text-danger">
                        <i class="bi bi-x-circle"></i> Clear Filter
                    </a>
                </div>
            }
        </form>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search style='font-size: 3rem;' text-muted"></i>
                <p class="mt-3">No reports found for this category.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="glass-panel-light h-100 p-3 rounded-4 shadow-sm border-0">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary-subtle text-primary">@item.Category?.Name</span>
                            <span class="small text-muted">@item.Status</span>
                        </div>
                        <h5 class="fw-bold">@item.Title</h5>
                        <p class="text-muted small">
                            <i class="bi bi-geo-alt text-danger"></i> @item.District?.City?.Name - @item.District?.Name
                        </p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill w-100">Details</a>
                    </div>
                </div>
            }
        }
    </div>
</div>