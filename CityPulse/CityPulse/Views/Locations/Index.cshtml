@model LocationsViewModel

<div class="container py-4">
    <div class="row">
        <div class="col-md-4">
            <div class="glass-panel-light p-4 rounded-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Cities</h5>
                    <a asp-action="AddCity" class="btn btn-sm btn-primary-gradient rounded-pill px-3">+ City</a>
                </div>
                
                <div class="list-group list-group-flush">
                    @foreach (var city in Model.Cities)
                    {
                        <div class="d-flex align-items-center mb-1">
                            <a asp-action="Index" asp-route-selectedCityId="@city.Id"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 rounded-3 flex-grow-1 me-2 @(ViewData["SelectedCityId"]?.ToString() == city.Id.ToString() ? "bg-primary text-white" : "")">
        
                                <span>@city.Name</span>
                            </a>

                            <a asp-action="Delete" asp-route-id="@city.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                Delete
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="glass-panel-light p-4 rounded-4 shadow-sm min-vh-50">
                @if (ViewData["SelectedCityId"] != null)
                {
                    var selectedCity = Model.Cities.First(c => c.Id == (int)ViewData["SelectedCityId"]);
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Districts in @selectedCity.Name</h5>
                        <a asp-controller="Districts" asp-action="Create" asp-route-cityId="@selectedCity.Id"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">+ New District</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-muted small">
                                    <th>District Name</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Districts)
                                {
                                    <tr>
                                        <td class="fw-bold">@d.Name</td>
                                        <td class="text-end">
                                            <a asp-controller="Districts" asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary rounded-pill">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-geo-alt display-1 text-light-emphasis"></i>
                        <p class="text-muted mt-3">Please select a city from the left to manage its districts.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>